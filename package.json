{
  "name": "campuspass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:types": "node scripts/database/generate-types.mjs",
    "db:types:check": "node scripts/database/generate-types.mjs --check",
    "test:db": "node scripts/database/policy-test.mjs",
    "test:integration": "node scripts/database/api-test.mjs && node scripts/database/live-api-test.mjs && node scripts/database/admission-api-test.mjs && node scripts/database/waitlist-api-test.mjs && node scripts/database/reporting-api-test.mjs",
    "test:e2e:integration": "playwright test --config playwright.integration.config.ts",
    "test:db:concurrency": "node scripts/database/concurrency-test.mjs && node scripts/database/booking-concurrency-test.mjs && node scripts/database/admission-concurrency-test.mjs && node scripts/database/waitlist-concurrency-test.mjs && node scripts/database/reporting-concurrency-test.mjs",
    "operator:provision": "node scripts/operator/provision.mjs",
    "dev:fixtures": "node scripts/database/live-fixture.mjs",
    "dev:fixtures:clean": "node scripts/database/live-fixture.mjs --clean"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@supabase/typegen": "0.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
