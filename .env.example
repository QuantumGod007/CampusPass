# Authentication infrastructure is opt-in. The existing demo needs no credentials.
VITE_AUTH_ENABLED=false

# Supabase Dashboard > Project Settings > API: Project URL.
VITE_SUPABASE_URL=

# Supabase Dashboard > Project Settings > API Keys: publishable key (sb_publishable_...).
# VITE_ values are public. Never put a secret or service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
